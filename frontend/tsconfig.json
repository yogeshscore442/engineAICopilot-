{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/api.ts",
    "src/types.ts",
    "src/pqcClient.ts",
    "src/mockData.ts",
    "src/components/HealthBanner.tsx",
    "src/components/UploadStep.tsx",
    "src/components/ReviewStep.tsx",
    "src/components/ChatPanel.tsx",
    "src/components/SummaryStep.tsx",
    "src/vite-env.d.ts"
  ]
}
